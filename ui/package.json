{
  "name": "cide-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:close": "node scripts/check-close-confirm.mjs",
    "check:diff": "node scripts/check-diff-selection.mjs",
    "check:diff-render": "node scripts/check-diff-render.mjs",
    "check:editor": "node scripts/check-editor.mjs",
    "check:exit": "node scripts/check-exit-marker.mjs",
    "check:format": "node scripts/check-status-format.mjs",
    "check:git": "node scripts/check-git-tree.mjs",
    "check:input": "node scripts/check-input-emitters.mjs",
    "check:keys": "node scripts/check-key-gate.mjs",
    "check:picker": "node scripts/check-picker.mjs",
    "check:problems": "node scripts/check-problems.mjs",
    "check:render": "node scripts/check-git-render.mjs",
    "check:rows": "node scripts/check-rows.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:tree-status": "node scripts/check-tree-status.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "//": "Versions are pinned exactly, with no carets. Vite 8 defaults to the Rolldown/Oxc pipeline, where the known breakage class is plugins reaching into Rollup internals \u2014 a caret range would let that arrive unannounced during a milestone.",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@tanstack/react-virtual": "3.13.12",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
